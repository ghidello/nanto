<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nanto</ToolCommandName>
    <PackageId>Nanto.Cli</PackageId>
    <RootNamespace>Nanto.Cli</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nanto.Cli.Tests" />
    <InternalsVisibleTo Include="Nanto.DevLoop.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Schemas/nanto-config-v1.schema.json" Pack="true" PackagePath="schemas/nanto-config-v1.schema.json" />
  </ItemGroup>
</Project>
