{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanto.dev/schemas/plugin-manifest/v1.json",
  "title": "Nanto plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "catalogFingerprint",
    "runtimeCompatibility",
    "dependencies",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/pluginId"
    },
    "catalogFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "runtimeCompatibility": {
      "oneOf": [
        {
          "const": "nativeAot"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "dependencyPackage",
            "dependencyVersion",
            "reason"
          ],
          "properties": {
            "mode": {
              "const": "coreClr"
            },
            "dependencyPackage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
            },
            "dependencyVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\s]+$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9.-]*$"
            }
          }
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pluginId"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "members"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*:[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
            }
          },
          "scopeSchema": {
            "$ref": "#/$defs/packagePath"
          }
        }
      }
    },
    "frontendModule": {
      "$ref": "#/$defs/packagePath"
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\])[^/]+(?:/[^/]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  }
}
