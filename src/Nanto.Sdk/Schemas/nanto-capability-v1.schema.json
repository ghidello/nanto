{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanto.dev/schemas/capability/v1.json",
  "title": "Nanto capability document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identifier",
    "windows",
    "origins",
    "permissions"
  ],
  "properties": {
    "$schema": {
      "const": "https://nanto.dev/schemas/capability/v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "main"
      }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "scope"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "scope": {}
            }
          }
        ]
      }
    }
  }
}
