<Project>
  <PropertyGroup>
    <NantoSdkAssembly Condition="'$(NantoSdkAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\Nanto.Sdk.dll</NantoSdkAssembly>
    <NantoAssetResourcePrefix Condition="'$(NantoAssetResourcePrefix)' == ''">Nanto.AppAssets/</NantoAssetResourcePrefix>
    <NantoAssetManifestResourceName Condition="'$(NantoAssetManifestResourceName)' == ''">Nanto.AppAssets.Manifest</NantoAssetManifestResourceName>
    <NantoSdkToolBuildTarget Condition="'$(NantoSdkToolBuildTarget)' == ''"></NantoSdkToolBuildTarget>
    <NantoBrowserCoreSource Condition="'$(NantoBrowserCoreSource)' == ''">$(MSBuildThisFileDirectory)..\browser\core\index.ts</NantoBrowserCoreSource>
    <_NantoSdkTargetsFile>$(MSBuildThisFileFullPath)</_NantoSdkTargetsFile>
  </PropertyGroup>

  <Target Name="GenerateNantoPluginCatalog" BeforeTargets="CoreCompile" DependsOnTargets="$(NantoSdkToolBuildTarget);ResolvePackageAssets">
    <PropertyGroup>
      <NantoPluginIntermediateDirectory Condition="'$(NantoPluginIntermediateDirectory)' == ''">$(IntermediateOutputPath)Nanto\Plugins</NantoPluginIntermediateDirectory>
      <NantoPluginCatalogOutputPath Condition="'$(NantoPluginCatalogOutputPath)' == ''">$(NantoPluginIntermediateDirectory)\nanto-plugin-catalog-v1.json</NantoPluginCatalogOutputPath>
      <NantoPluginSelectionSnapshotOutputPath Condition="'$(NantoPluginSelectionSnapshotOutputPath)' == ''">$(NantoPluginIntermediateDirectory)\nanto-plugin-selection-v1.json</NantoPluginSelectionSnapshotOutputPath>
      <_NantoPluginResponseFile>$(NantoPluginIntermediateDirectory)\plugin-inputs.rsp</_NantoPluginResponseFile>
    </PropertyGroup>
    <ItemGroup>
      <_NantoPluginRestoreInput Include="$(MSBuildAllProjects)" />
      <_NantoPluginRestoreInput Remove="$(_NantoSdkTargetsFile)" />
      <_NantoPluginRestoreInput Include="$(_NantoSdkTargetsFile)" />
      <_NantoPluginRestoreInput Include="$(RestoreConfigFile)" Condition="'$(RestoreConfigFile)' != ''" />
      <_NantoPluginRestoreInput Include="$(NuGetLockFilePath)" Condition="'$(NuGetLockFilePath)' != ''" />
      <_NantoPluginRestoreInput Include="@(NantoPluginManifest->'%(DefiningProjectFullPath)')" />
      <_NantoPluginRestoreProperty Include="CentralPackageTransitivePinningEnabled">
        <Value>$(CentralPackageTransitivePinningEnabled)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="ManagePackageVersionsCentrally">
        <Value>$(ManagePackageVersionsCentrally)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RestoreAdditionalProjectSources">
        <Value>$(RestoreAdditionalProjectSources)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RestoreConfigFile">
        <Value>$(RestoreConfigFile)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RestoreLockedMode">
        <Value>$(RestoreLockedMode)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RestorePackagesPath">
        <Value>$(RestorePackagesPath)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RestorePackagesWithLockFile">
        <Value>$(RestorePackagesWithLockFile)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RestoreSources">
        <Value>$(RestoreSources)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RuntimeIdentifier">
        <Value>$(RuntimeIdentifier)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="RuntimeIdentifiers">
        <Value>$(RuntimeIdentifiers)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="TargetFramework">
        <Value>$(TargetFramework)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginRestoreProperty Include="TargetFrameworks">
        <Value>$(TargetFrameworks)</Value>
      </_NantoPluginRestoreProperty>
      <_NantoPluginSdkInput Include="assetsfile=$(ProjectAssetsFile)" />
      <_NantoPluginSdkInput Include="targetframework=$(TargetFramework)" />
      <_NantoPluginSdkInput Include="projectfile=$(MSBuildProjectFullPath)" />
      <_NantoPluginSdkInput Include="configuration=$(Configuration)" />
      <_NantoPluginSdkInput Include="@(_NantoPluginRestoreProperty->'restoreproperty=%(Identity)|%(Value)')" />
      <_NantoPluginSdkInput Include="@(_NantoPluginRestoreInput->'restoreinput=%(FullPath)')" />
      <_NantoPluginSdkInput Include="@(NantoPluginManifest->'manifest=%(FullPath)|%(PackageId)')" />
    </ItemGroup>
    <MakeDir Directories="$(NantoPluginIntermediateDirectory)" />
    <WriteLinesToFile File="$(_NantoPluginResponseFile)" Lines="@(_NantoPluginSdkInput)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <Exec Command="dotnet &quot;$(NantoSdkAssembly)&quot; plugins &quot;$(_NantoPluginResponseFile)&quot; &quot;$(NantoPluginCatalogOutputPath)&quot; &quot;$(NantoPluginSelectionSnapshotOutputPath)&quot;" />
    <ItemGroup>
      <FileWrites Include="$(_NantoPluginResponseFile);$(NantoPluginCatalogOutputPath);$(NantoPluginSelectionSnapshotOutputPath)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateNantoContracts" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences;GenerateNantoPluginCatalog">
    <PropertyGroup>
      <NantoFrontendIntermediateDirectory Condition="'$(NantoFrontendIntermediateDirectory)' == ''">$(IntermediateOutputPath)Nanto\Frontend</NantoFrontendIntermediateDirectory>
      <NantoFrontendOutputPath Condition="'$(NantoFrontendOutputPath)' == ''">$(NantoFrontendIntermediateDirectory)\@nanto\app</NantoFrontendOutputPath>
      <_NantoSdkResponseFile>$(NantoFrontendIntermediateDirectory)\compiler-inputs.rsp</_NantoSdkResponseFile>
      <_NantoJsonContextFile>$(NantoFrontendIntermediateDirectory)\NantoGeneratedJsonContext.g.cs</_NantoJsonContextFile>
      <_NantoCapabilityPolicyFile>$(NantoFrontendIntermediateDirectory)\NantoGeneratedCapabilityPolicy.g.cs</_NantoCapabilityPolicyFile>
      <_NantoCapabilityInspectionFile>$(NantoFrontendIntermediateDirectory)\nanto-capability-policy-v1.json</_NantoCapabilityInspectionFile>
      <_NantoTypeScriptFile>$(NantoFrontendOutputPath)\index.ts</_NantoTypeScriptFile>
      <NantoBrowserCoreOutputPath Condition="'$(NantoBrowserCoreOutputPath)' == ''">$(NantoFrontendOutputPath)\..\core\index.ts</NantoBrowserCoreOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <_NantoSdkInput Include="define=$(DefineConstants)" />
      <_NantoSdkInput Include="langversion=$(LangVersion)" />
      <_NantoSdkInput Include="nullable=$(Nullable)" />
      <_NantoSdkInput Include="projectdir=$(MSBuildProjectDirectory)" />
      <_NantoSdkInput Include="pluginresponse=$(_NantoPluginResponseFile)" />
      <_NantoSdkInput Include="@(NantoCapability->'capability=%(FullPath)')" />
      <_NantoSdkInput Include="@(Compile->'source=%(FullPath)')" />
      <_NantoSdkInput Include="@(ReferencePath->'reference=%(FullPath)')" />
    </ItemGroup>
    <MakeDir Directories="$(NantoFrontendIntermediateDirectory)" />
    <WriteLinesToFile File="$(_NantoSdkResponseFile)" Lines="@(_NantoSdkInput)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <Exec Command="dotnet &quot;$(NantoSdkAssembly)&quot; &quot;$(_NantoSdkResponseFile)&quot; &quot;$(_NantoJsonContextFile)&quot; &quot;$(_NantoTypeScriptFile)&quot; &quot;$(_NantoCapabilityPolicyFile)&quot; &quot;$(_NantoCapabilityInspectionFile)&quot;" />
    <Exec Command="dotnet &quot;$(NantoSdkAssembly)&quot; copy &quot;$(NantoBrowserCoreSource)&quot; &quot;$(NantoBrowserCoreOutputPath)&quot;"
          Condition="Exists('$(NantoBrowserCoreSource)')" />
    <ItemGroup>
      <Compile Include="$(_NantoJsonContextFile)" />
      <Compile Include="$(_NantoCapabilityPolicyFile)" />
      <FileWrites Include="$(_NantoSdkResponseFile);$(_NantoJsonContextFile);$(_NantoCapabilityPolicyFile);$(_NantoCapabilityInspectionFile);$(_NantoTypeScriptFile);$(NantoBrowserCoreOutputPath)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateNantoAssetManifest"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="$(NantoSdkToolBuildTarget)"
          Condition="'$(NantoFrontendDist)' != '' and ('$(NantoIncludeProductionAssets)' == 'true' or '$(IsPublishing)' == 'true')">
    <PropertyGroup>
      <_NantoFrontendDist>$([System.IO.Path]::GetFullPath('$(NantoFrontendDist)', '$(MSBuildProjectDirectory)'))</_NantoFrontendDist>
      <_NantoAssetManifestFile>$(IntermediateOutputPath)Nanto\Assets\nanto-assets.json</_NantoAssetManifestFile>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(NantoSdkAssembly)&quot; assets &quot;$(_NantoFrontendDist)&quot; &quot;$(_NantoAssetManifestFile)&quot; &quot;$(NantoAssetResourcePrefix)&quot;" />
    <ItemGroup>
      <_NantoAsset Include="$(_NantoFrontendDist)\**\*" />
      <_NantoAsset>
        <NantoRelativePath>$([System.String]::Copy('%(_NantoAsset.RecursiveDir)').Replace('\', '/'))%(_NantoAsset.Filename)%(_NantoAsset.Extension)</NantoRelativePath>
      </_NantoAsset>
    </ItemGroup>
    <GetFileHash Files="@(_NantoAsset)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_NantoHashedAsset" />
    </GetFileHash>
    <ItemGroup>
      <_NantoHashedAsset>
        <LogicalName>$(NantoAssetResourcePrefix)%(_NantoHashedAsset.FileHash)/%(_NantoHashedAsset.NantoRelativePath)</LogicalName>
      </_NantoHashedAsset>
      <EmbeddedResource Include="@(_NantoHashedAsset)" />
      <EmbeddedResource Include="$(_NantoAssetManifestFile)" LogicalName="$(NantoAssetManifestResourceName)" />
      <FileWrites Include="$(_NantoAssetManifestFile)" />
    </ItemGroup>
  </Target>

  <Target Name="RequireNantoProductionAssets"
          BeforeTargets="PrepareForBuild"
          Condition="'$(NantoRequireProductionAssets)' == 'true' and '$(NantoFrontendDist)' == ''">
    <Error Text="Nanto production assets require NantoFrontendDist. Set it in the project or publish through 'dotnet nanto build'." />
  </Target>

  <Target Name="ValidateNantoBuildMode"
          BeforeTargets="PrepareForBuild;Publish"
          Condition="'$(NantoBuildMode)' != '' and '$(NantoBuildMode)' != 'CoreClrFrameworkDependent' and '$(NantoBuildMode)' != 'CoreClrSelfContained' and '$(NantoBuildMode)' != 'NativeAot'">
    <Error Text="Unknown NantoBuildMode '$(NantoBuildMode)'. Expected CoreClrFrameworkDependent, CoreClrSelfContained, or NativeAot." />
  </Target>
</Project>
