<Project>
  <ItemGroup>
    <NantoCapability Include="$(MSBuildProjectDirectory)\Capabilities\**\*.nanto-capability.json" />
  </ItemGroup>

  <PropertyGroup Condition="'$(NantoBuildMode)' == 'CoreClrFrameworkDependent'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NantoBuildMode)' == 'CoreClrSelfContained'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NantoBuildMode)' == 'NativeAot'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
</Project>
