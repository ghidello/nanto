<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <_NantoRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_NantoRepositoryRoot>
    <_NantoPublishDirectory>$(_NantoRepositoryRoot)\artifacts\phase1\publish\native-aot\win-x64</_NantoPublishDirectory>
    <_NantoSymbolDirectory>$(_NantoRepositoryRoot)\artifacts\phase1\symbols\native-aot\win-x64</_NantoSymbolDirectory>
    <_NantoPackageDirectory>$(_NantoRepositoryRoot)\artifacts\phase1\packages\native-aot</_NantoPackageDirectory>
    <_NantoEvidencePath>$(_NantoRepositoryRoot)\artifacts\phase1\evidence\deployment\native-aot.json</_NantoEvidencePath>
    <_NantoMapPath>$(_NantoRepositoryRoot)\artifacts\phase1\evidence\deployment\native-aot.map.xml</_NantoMapPath>
    <_NantoTestAppOutputDirectory>$(_NantoRepositoryRoot)\tests\Nanto.Hosting.Windows.TestApp\bin\NativeAot\Release\net10.0-windows10.0.19041.0\win-x64</_NantoTestAppOutputDirectory>
    <_NantoTestAppIntermediateDirectory>$(_NantoRepositoryRoot)\tests\Nanto.Hosting.Windows.TestApp\obj\NativeAot\Release\net10.0-windows10.0.19041.0\win-x64\native</_NantoTestAppIntermediateDirectory>
    <_NantoAssetManifestPath>$(_NantoRepositoryRoot)\tests\Nanto.Hosting.Windows.TestApp\obj\NativeAot\Release\net10.0-windows10.0.19041.0\win-x64\Nanto\Assets\nanto-assets.json</_NantoAssetManifestPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nanto.Hosting.Windows.IntegrationTestKit/Nanto.Hosting.Windows.IntegrationTestKit.csproj" />
    <ProjectReference Include="../Nanto.Hosting.Windows.TestApp/Nanto.Hosting.Windows.TestApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Nanto.Hosting.Windows.TestProtocol/Nanto.Hosting.Windows.TestProtocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoRepositoryRoot</_Parameter1>
      <_Parameter2>$(_NantoRepositoryRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoPublishDirectory</_Parameter1>
      <_Parameter2>$(_NantoPublishDirectory)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoSymbolDirectory</_Parameter1>
      <_Parameter2>$(_NantoSymbolDirectory)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoPackageDirectory</_Parameter1>
      <_Parameter2>$(_NantoPackageDirectory)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoEvidencePath</_Parameter1>
      <_Parameter2>$(_NantoEvidencePath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoMapPath</_Parameter1>
      <_Parameter2>$(_NantoMapPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoAssetManifestPath</_Parameter1>
      <_Parameter2>$(_NantoAssetManifestPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NantoSdkVersion</_Parameter1>
      <_Parameter2>$(NETCoreSdkVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="PrepareNantoNativeAotDeployment"
          BeforeTargets="_MTPBuild"
          Condition="'$(NantoTestAssemblyExcluded)' != 'true'">
    <RemoveDir Directories="$(_NantoPublishDirectory);$(_NantoSymbolDirectory);$(_NantoPackageDirectory)" />
    <Delete Files="$(_NantoEvidencePath);$(_NantoMapPath)" />
    <MakeDir Directories="$(_NantoPublishDirectory);$(_NantoSymbolDirectory)\managed;$(_NantoSymbolDirectory)\native;$(_NantoPackageDirectory)" />
    <MSBuild Projects="../Nanto.Hosting.Windows.TestApp/Nanto.Hosting.Windows.TestApp.csproj"
             Targets="Restore"
             RemoveProperties="CurrentSolutionConfigurationContents;BuildingSolutionFile;ShouldUnsetParentConfigurationAndPlatform"
             Properties="Configuration=Release;NantoBuildMode=NativeAot" />
    <MSBuild Projects="../Nanto.Hosting.Windows.TestApp/Nanto.Hosting.Windows.TestApp.csproj"
             Targets="GetNantoTestAppLaunchPath"
             RemoveProperties="CurrentSolutionConfigurationContents;BuildingSolutionFile;ShouldUnsetParentConfigurationAndPlatform"
             Properties="Configuration=Release;NantoBuildMode=NativeAot">
      <Output TaskParameter="TargetOutputs" ItemName="_NantoTestAppLaunchPath" />
    </MSBuild>
    <Error Condition="'@(_NantoTestAppLaunchPath->'%(Extension)')' != '.exe'"
           Text="Native AOT TestApp must expose its executable apphost as the launch path." />
    <MSBuild Projects="../Nanto.Hosting.Windows.TestApp/Nanto.Hosting.Windows.TestApp.csproj"
             Targets="Publish"
             RemoveProperties="CurrentSolutionConfigurationContents;BuildingSolutionFile;ShouldUnsetParentConfigurationAndPlatform"
             Properties="Configuration=Release;NantoBuildMode=NativeAot;PublishDir=$(_NantoPublishDirectory)\;IlcGenerateMapFile=true" />
    <ItemGroup>
      <_NantoManagedSymbols Include="$(_NantoTestAppOutputDirectory)\*.pdb" />
      <_NantoNativeSymbols Include="$(_NantoTestAppOutputDirectory)\native\*.pdb" />
      <_NantoPublishedSymbols Include="$(_NantoPublishDirectory)\**\*.pdb" />
      <_NantoMap Include="$(_NantoTestAppIntermediateDirectory)\Nanto.Hosting.Windows.TestApp.map.xml" />
    </ItemGroup>
    <Error Condition="'@(_NantoNativeSymbols)' == ''" Text="The Native AOT TestApp publication did not produce a separately retainable linker PDB." />
    <Error Condition="!Exists('$(_NantoTestAppIntermediateDirectory)\Nanto.Hosting.Windows.TestApp.map.xml')"
           Text="The Native AOT TestApp publication did not produce its reachability map." />
    <Copy SourceFiles="@(_NantoManagedSymbols)" DestinationFolder="$(_NantoSymbolDirectory)\managed" />
    <Copy SourceFiles="@(_NantoNativeSymbols)" DestinationFolder="$(_NantoSymbolDirectory)\native" />
    <Copy SourceFiles="@(_NantoMap)" DestinationFiles="$(_NantoMapPath)" />
    <Delete Files="@(_NantoPublishedSymbols)" />
  </Target>
</Project>
