<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NantoSdkAssembly>$(MSBuildThisFileDirectory)..\..\src\Nanto.Sdk\bin\$(Configuration)\net10.0\Nanto.Sdk.dll</NantoSdkAssembly>
    <NantoSdkToolBuildTarget>BuildNantoSdkTool</NantoSdkToolBuildTarget>
    <NantoBrowserCoreSource>$(MSBuildThisFileDirectory)..\..\frontend\packages\core\src\index.ts</NantoBrowserCoreSource>
    <NantoFrontendDist>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)$(Configuration)\Nanto\TestWebAssets', '$(MSBuildProjectDirectory)'))</NantoFrontendDist>
    <NantoIncludeProductionAssets>true</NantoIncludeProductionAssets>
    <NantoAssetResourcePrefix>Nanto.Hosting.Windows.TestApp.WebAssets/</NantoAssetResourcePrefix>
    <NantoAssetManifestResourceName>Nanto.Hosting.Windows.TestApp.WebAssets.nanto-assets.json</NantoAssetManifestResourceName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Nanto.Core/Nanto.Core.csproj" />
    <ProjectReference Include="../../src/Nanto.Hosting.Windows/Nanto.Hosting.Windows.csproj" />
    <ProjectReference Include="../../src/Nanto.Generators/Nanto.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Nanto.Hosting.Windows.TestProtocol/Nanto.Hosting.Windows.TestProtocol.csproj" />
    <ProjectReference Include="../Nanto.Hosting.Windows.TestApp.Interop/Nanto.Hosting.Windows.TestApp.Interop.csproj" />
  </ItemGroup>
  <Target Name="BuildNantoSdkTool" BeforeTargets="GenerateNantoContracts">
    <MSBuild Projects="../../src/Nanto.Sdk/Nanto.Sdk.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;PublishSingleFile;NantoBuildMode" />
  </Target>
  <Target Name="PrepareNantoTestWebAssets" BeforeTargets="GenerateNantoAssetManifest">
    <ItemGroup>
      <_NantoTestWebAsset Include="WebAssets\**\*" Exclude="WebAssets\nanto-assets.json" />
      <_NantoPreparedTestWebAsset Include="@(_NantoTestWebAsset->'$(NantoFrontendDist)\%(RecursiveDir)%(Filename)%(Extension)')" />
      <_NantoPreparedTestWebAsset Include="$(NantoFrontendDist)\nanto-core.js;$(NantoFrontendDist)\nanto-app.js" />
    </ItemGroup>
    <RemoveDir Directories="$(NantoFrontendDist)" />
    <MakeDir Directories="$(NantoFrontendDist)" />
    <Copy SourceFiles="@(_NantoTestWebAsset)" DestinationFiles="@(_NantoTestWebAsset->'$(NantoFrontendDist)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="../../frontend/packages/core/dist/index.js" DestinationFiles="$(NantoFrontendDist)\nanto-core.js" />
    <Copy SourceFiles="../../frontend/packages/app/dist/index.js" DestinationFiles="$(NantoFrontendDist)\nanto-app.js" />
    <ItemGroup>
      <FileWrites Include="@(_NantoPreparedTestWebAsset)" />
    </ItemGroup>
  </Target>
  <Target Name="GetNantoTestAppLaunchPath" Returns="@(_NantoTestAppLaunchPath)">
    <ItemGroup>
      <_NantoTestAppLaunchPath Include="$(TargetPath)" Condition="'$(UseAppHost)' != 'true'" />
      <_NantoTestAppLaunchPath Include="$(RunCommand)" Condition="'$(UseAppHost)' == 'true'" />
    </ItemGroup>
  </Target>
  <Import Project="../../src/Nanto.Hosting.Windows/buildTransitive/Nanto.Hosting.Windows.targets" />
  <Import Project="../../src/Nanto.Sdk/buildTransitive/Nanto.Sdk.targets" />
</Project>
