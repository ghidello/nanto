<Project>
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <!-- An explicitly empty command-line property remains empty because global properties cannot be overwritten, so validation rejects it. -->
    <NantoBuildMode Condition="'$(NantoBuildMode)' == ''">CoreClrFrameworkDependent</NantoBuildMode>
    <BaseIntermediateOutputPath>obj\$(NantoBuildMode)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(NantoBuildMode)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NantoBuildMode)' == 'CoreClrFrameworkDependent'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NantoBuildMode)' == 'CoreClrSelfContained'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NantoBuildMode)' == 'NativeAot'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <Target Name="ValidateNantoBuildMode"
          BeforeTargets="PrepareForBuild;Publish;GetNantoTestAppLaunchPath"
          Condition="'$(NantoBuildMode)' != 'CoreClrFrameworkDependent' and '$(NantoBuildMode)' != 'CoreClrSelfContained' and '$(NantoBuildMode)' != 'NativeAot'">
    <Error Text="Unknown NantoBuildMode '$(NantoBuildMode)'. Expected CoreClrFrameworkDependent, CoreClrSelfContained, or NativeAot." />
  </Target>
</Project>
