<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Nanto.WinRtAppearanceInteropGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.NET.Ref"
                      GeneratePathProperty="true"
                      PrivateAssets="all"
                      ExcludeAssets="all" />
  </ItemGroup>

  <Target Name="UpdateWinRtAppearanceInterop" DependsOnTargets="Build">
    <PropertyGroup>
      <WinRtAppearanceSpecPath>$(MSBuildProjectDirectory)\winrt-appearance-spec.json</WinRtAppearanceSpecPath>
      <WinRtAppearanceUpdateDirectory>$(MSBuildProjectDirectory)\obj\update\$(Configuration)\Generated</WinRtAppearanceUpdateDirectory>
      <WinRtAppearanceCommittedDirectory>$(MSBuildProjectDirectory)\..\..\src\Nanto.Hosting.Windows\Interop\Generated</WinRtAppearanceCommittedDirectory>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --package-root &quot;$(PkgMicrosoft_Windows_SDK_NET_Ref)&quot; --spec &quot;$(WinRtAppearanceSpecPath)&quot; --output &quot;$(WinRtAppearanceUpdateDirectory)&quot;" />
    <ItemGroup>
      <_GeneratedInterop Include="$(WinRtAppearanceUpdateDirectory)\WinRtAppearanceInterop.g.cs" />
      <_GeneratedInterop Include="$(WinRtAppearanceUpdateDirectory)\winrt-appearance-interop-manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_GeneratedInterop)" DestinationFolder="$(WinRtAppearanceCommittedDirectory)" SkipUnchangedFiles="true" />
  </Target>
</Project>
